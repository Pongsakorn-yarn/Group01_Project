    <visual>
      <origin xyz="0.028 0 -0.029" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/10_Asm_06_Turntable_Right_Wall.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <joint name="joint_1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="turntable_link"/>
    <origin xyz="-0.028 0 0.029" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="3.14"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.028 0 -0.064" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/17_Asm_08_Upper_Main_Arm_L.stl" scale="0.001 0.001 0.001"/>
