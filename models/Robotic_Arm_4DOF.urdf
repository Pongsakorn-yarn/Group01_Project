    <origin xyz="0.028 0.012 -0.0005" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.08" upper="0.65" effort="1.0" velocity="3.14"/>
  </joint>

  <link name="gripper_claw_right_link">
