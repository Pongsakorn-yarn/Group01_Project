<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  @file        models/Robotic_Arm_4DOF.urdf
  @project     ISY49303 IoT — Group01_Project (4-DOF Robotic Arm Digital Twin)
  @description ไฟล์โครงสร้างหุ่นยนต์มาตรฐาน URDF (XML) สำหรับจำลองใน ROS / PyBullet / Gazebo
  ==============================================================================
  @units       ไฟล์ STL ต้นฉบับมีหน่วยเป็นมิลลิเมตร (mm) จึงกำหนด scale="0.001 0.001 0.001"
               เพื่อแปลงเป็นหน่วยเมตร (m) ตามมาตรฐาน ROS
  @kinematics  base_link -> joint_1_base_yaw (Z: -90..+90 deg) -> turntable_link
               -> joint_2_shoulder_pitch (Y: -45..+65 deg) -> upper_arm_link
               -> joint_3_elbow_pitch (Y: -55..+55 deg) -> forearm_link
               -> joint_wrist_parallel (Y: -45..+45 deg) -> gripper_base_link
               -> joint_4_gripper_left / right (Z / -Z, mimic)
  @note        URDF แทนโครงสร้างกลไกปิด 4-Bar Parallel Linkage ด้วยลูกโซ่อนุกรม (Serial Chain)
               พร้อมกำหนด <inertial> เบื้องต้นในแต่ละ Link เพื่อให้โหลดจำลองใน Gazebo / PyBullet ได้
  ==============================================================================
-->
<robot name="Robotic_Arm_4DOF_Assembly">

  <material name="slate_dark">
    <color rgba="0.118 0.161 0.231 1.0"/>
  </material>
  <material name="cyan_acrylic">
    <color rgba="0.008 0.518 0.780 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/00_Asm_01_Main_Base_Plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="slate_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/05_Asm_02_Base_Servo_Plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <link name="turntable_link">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00015"/>
    </inertial>
    <visual>
      <origin xyz="0.028 0 -0.029" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/08_Asm_04_Turntable_Bottom.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="slate_dark"/>
    </visual>
    <visual>
      <origin xyz="0.028 0 -0.029" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/09_Asm_05_Turntable_Left_Wall.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
    <visual>
      <origin xyz="0.028 0 -0.029" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/10_Asm_06_Turntable_Right_Wall.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <joint name="joint_1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="turntable_link"/>
    <origin xyz="-0.028 0 0.029" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="3.14"/>
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0.017 0 0.036" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00003"/>
    </inertial>
    <visual>
      <origin xyz="0.028 0 -0.064" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/17_Asm_08_Upper_Main_Arm_L.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
    <visual>
      <origin xyz="0.028 0 -0.064" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/18_Asm_09_Upper_Main_Arm_R.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <joint name="joint_2_shoulder_pitch" type="revolute">
    <parent link="turntable_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7854" upper="1.1345" effort="2.0" velocity="3.14"/>
  </joint>

  <link name="forearm_link">
    <inertial>
      <origin xyz="0.040 0 -0.004" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="-0.005809 0 -0.136505" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/24_Asm_13_Forearm_Main_Link_L.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
    <visual>
      <origin xyz="-0.005809 0 -0.136505" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/25_Asm_13_Forearm_Main_Link_R.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <joint name="joint_3_elbow_pitch" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.033809 0 0.072505" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9599" upper="0.9599" effort="2.0" velocity="3.14"/>
  </joint>

  <link name="gripper_base_link">
    <inertial>
      <origin xyz="0.025 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="-0.085371 0 -0.128142" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/32_Asm_16_Gripper_Top_Mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="slate_dark"/>
    </visual>
    <visual>
      <origin xyz="-0.085371 0 -0.128142" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/33_Asm_17_Gripper_Bottom_Plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="slate_dark"/>
    </visual>
  </link>

  <joint name="joint_wrist_parallel" type="revolute">
    <parent link="forearm_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0.079562 0 -0.008363" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7854" upper="0.7854" effort="1.0" velocity="3.14"/>
  </joint>

  <link name="gripper_claw_left_link">
    <inertial>
      <origin xyz="0.020 0.006 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
    <visual>
      <origin xyz="-0.113371 -0.012 -0.127642" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/36_Asm_18_Gripper_Claw_Left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <joint name="joint_4_gripper_left" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_claw_left_link"/>
    <origin xyz="0.028 0.012 -0.0005" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.57" effort="1.0" velocity="3.14"/>
  </joint>

  <link name="gripper_claw_right_link">
    <inertial>
      <origin xyz="0.020 -0.006 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
    <visual>
      <origin xyz="-0.113371 0.012 -0.127642" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/37_Asm_19_Gripper_Claw_Right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <joint name="joint_4_gripper_right" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_claw_right_link"/>
    <origin xyz="0.028 -0.012 -0.0005" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.05" upper="0.57" effort="1.0" velocity="3.14"/>
    <mimic joint="joint_4_gripper_left" multiplier="1.0" offset="0.0"/>
  </joint>
</robot>
