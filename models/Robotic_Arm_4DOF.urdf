<?xml version="1.0"?>
<robot name="Robotic_Arm_4DOF_Assembly">
  <!-- Extracted from Robotic_Arm_4DOF_Assembly.sc (solidcraft-container/1) -->
  <!-- Units: millimeters (scaled 0.001 to meters for ROS/PyBullet compatibility) -->

  <material name="slate_dark">
    <color rgba="0.118 0.161 0.231 1.0"/>
  </material>
  <material name="cyan_acrylic">
    <color rgba="0.008 0.518 0.780 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/00_Asm_01_Main_Base_Plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="slate_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/05_Asm_02_Base_Servo_Plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cyan_acrylic"/>
    </visual>
  </link>

  <link name="turntable_link">
    <visual>
      <origin xyz="0.028 0 -0.029" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/08_Asm_04_Turntable_Bottom.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="slate_dark"/>
