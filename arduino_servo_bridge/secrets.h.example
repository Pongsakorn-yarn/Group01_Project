/**
 * =============================================================================
 * @file        arduino_servo_bridge/secrets.h.example
 * @project     ISY49303 IoT — Group01_Project (4-DOF Robotic Arm Digital Twin)
 * @description ไฟล์ต้นแบบสำหรับตั้งค่า Wi-Fi (2.4 GHz), บัญชี EMQX Cloud Serverless
 *              และใบรับรอง Root CA (TLS 1.2/1.3) สำหรับบอร์ด GOOUUU ESP32-S3-CAM
 *
 * วิธีใช้งาน (ห้ามอัปโหลด secrets.h ขึ้น Git — ถูกกันไว้ใน .gitignore แล้ว):
 *   1. คัดลอกไฟล์นี้เป็นชื่อ "secrets.h" ในโฟลเดอร์ arduino_servo_bridge/
 *   2. กรอกชื่อ Wi-Fi 2.4 GHz (WIFI_SSID / WIFI_PASS)
 *   3. กรอก Username/Password ของบัญชีบอร์ดบน EMQX Cloud (เช่น esp32_arm01)
 *   4. เปิดไฟล์ emqxsl-ca.crt ที่ดาวน์โหลดจากหน้า Overview ของ EMQX Cloud
 *      แล้วนำข้อความ -----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----
 *      มาวางแทนที่ใน EMQX_CA_CERT ด้านล่าง
 * =============================================================================
 */

#ifndef SECRETS_H
#define SECRETS_H

// ตั้งเป็น 1 เพื่อเปิดใช้งานระบบไร้สาย Cloud MQTT (TLS 8883) คู่กับ USB Serial
// ตั้งเป็น 0 หากต้องการรันโหมด USB WebSerial ล้วน
#define ENABLE_CLOUD_MQTT 1

// 1. เครือข่าย Wi-Fi (GOOUUU ESP32-S3-CAM รองรับเฉพาะคลื่น 2.4 GHz)
static const char* WIFI_SSID = "YOUR_WIFI_24GHZ_SSID";
static const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";

// 2. ข้อมูล EMQX Cloud Serverless Deployment ของโปรเจกต์
static const char* MQTT_BROKER_HOST  = "h0ace9f7.ala.asia-southeast1.emqxsl.com";
static const uint16_t MQTT_BROKER_PORT = 8883; // MQTT over TLS (ห้ามใช้ 1883 บน Serverless)

// 3. บัญชีอุปกรณ์ที่สร้างไว้ใน EMQX Cloud -> Access Control -> Authentication
static const char* MQTT_USERNAME     = "esp32_arm01";
static const char* MQTT_PASSWORD     = "YOUR_ESP32_MQTT_PASSWORD";
static const char* MQTT_CLIENT_ID    = "group01-esp32s3-arm01";

// 4. โครงสร้าง Topic มาตรฐาน ISA-95 / UNS (ต้องตรงกับหน้าเว็บ Digital Twin)
static const char* MQTT_TOPIC_PREFIX = "kmutt/isy49303/group01/arm01";

// 5. ใบรับรอง Root CA ของ EMQX Cloud (ดาวน์โหลด emqxsl-ca.crt จากหน้า Overview ของ EMQX Cloud)
// วางเนื้อหาใบรับรองทั้งหมดระหว่าง R"EOF( และ )EOF"
static const char* EMQX_CA_CERT = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE_YOUR_EMQXSL_CA_CRT_CONTENT_HERE
-----END CERTIFICATE-----
)EOF";

#endif // SECRETS_H
